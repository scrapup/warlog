@startuml
!include <C4/C4_Component>
title warlog - C4 Level 3 (Core components, mediator)

Container(mcp, "MCP adapter", "MCP SDK", "Registers one tool per operation; formats results")
Container(cli, "CLI adapter", "commander", "Generates one command per operation; flags, --file, help, exit codes")
ContainerDb(store, "Global store + repository .warlog", "Files")

Container_Boundary(core, "Core") {
  Component(registry, "Operation registry", "TypeScript", "OperationDefinition[]: name, group/action, kind (command|query), zod input, description, examples, handler")
  Component(mediator, "Mediator", "TypeScript", "Resolves the definition by name and runs the behavior pipeline around the handler")
  Component(bErr, "ErrorMapping behavior", "Pipeline", "Outermost: maps any failure to a WarlogError code")
  Component(bCtx, "Context behavior", "Pipeline", "Resolves global root, repository root (main worktree .warlog or global mode), repo key, branch, project default, machine id")
  Component(bVal, "Validation behavior", "Pipeline + zod", "Parses input; VALIDATION with field paths")
  Component(bSec, "SecretGuard behavior", "Pipeline", "Commands only: scans string leaves with linear-time matchers; SECRET_REJECTED")
  Component(bAct, "Activity behavior", "Pipeline", "Commands only: appends the activity record after the handler succeeds")
  Component(handlers, "Domain handlers", "TypeScript", "tracker, project, epic, story, task, subtask, note, comment, template, memory, link, trace, external, var, questionnaire, response, playbook, doc, doctor")
  Component(docimp, "DocumentImporter", "TypeScript", "Reads files by path, validates (size, links, SDD sections), copies assets + .puml, rewrites image links, builds section index, versions on request")
  Component(presenter,"Presenter", "TypeScript", "table | yaml (front matter + body) | json; fields; pagination")
  Component(index, "Index", "In-memory maps", "Entities, links + backlinks, external keys, usage, pending links, invalid files, conflict copies")
  Component(repo, "FileRepository", "fs + yaml (1.2 core)", "Read/serialize entities; rev check; atomic write (temp + fsync + rename)")
  Component(watcher, "Watcher", "fs.watch recursive + debounce", "Applies external changes to the index; full rescan on watcher error")
  Component(activity, "ActivityLog", "JSONL", "activity/<machine-id>/<yyyy-mm-dd>.jsonl append-only")
  Component(matchers, "Linear matchers", "TypeScript", "Secret patterns, glob, conflict-copy names, remote normalization - no backtracking")
}

Rel(mcp, mediator, "send(name, input)")
Rel(cli, mediator, "send(name, input)")
Rel(mcp, registry, "Enumerates operations")
Rel(cli, registry, "Enumerates operations")
Rel(mediator, registry, "Lookup")
Rel(mediator, bErr, "Pipeline")
Rel(bErr, bCtx, "next()")
Rel(bCtx, bVal, "next()")
Rel(bVal, bSec, "next()")
Rel(bSec, bAct, "next()")
Rel(bAct, handlers, "next()")
Rel(bSec, matchers, "Uses")
Rel(bAct, activity, "Append")
Rel(handlers, index, "Query")
Rel(handlers, repo, "Create / update")
Rel(handlers, docimp, "doc_import / doc_export")
Rel(docimp, matchers, "Link and secret scanning")
Rel(docimp, repo, "Atomic write of document, assets, meta")
Rel(repo, index, "Update after write")
Rel(watcher, index, "Apply external change")
Rel(repo, store, "Read / write")
Rel(watcher, store, "Watch")
Rel(activity, store, "Append")
Rel(mcp, presenter, "Format result")
Rel(cli, presenter, "Format result")

SHOW_LEGEND()
@enduml
