{
  "name": "@scrapup/warlog",
  "version": "1.1.4",
  "description": "File-based memory and execution ledger for AI coding agents",
  "license": "MIT",
  "author": "scrapup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scrapup/warlog.git"
  },
  "type": "module",
  "bin": {
    "warlog": "dist/bin/warlog.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    ".mcp.json",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test:unit": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "test:e2e": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects e2e-cli e2e-mcp",
    "bench": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects bench --passWithNoTests --runInBand",
    "rules:coverage": "node scripts/rules-coverage.ts",
    "verify:local": "node scripts/verify-local.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-jsdoc": "65.0.2",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
